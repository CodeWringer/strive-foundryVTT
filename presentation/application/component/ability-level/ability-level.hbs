{{!--
viewModel: AbilityLevelViewModel
--}}
<div id="{{viewModel.id}}" class="strive input ability-level flex flex-middle flex-row">
  <div class="edit-mode flex flex-row flex-middle">
    <div class="flex flex-center margin-r-md" style="position: relative; width: 3rem; height: 3rem">
      {{{themedImage "image.diamondBg" "fill" "position: relative;"}}}
      {{> inputNumberSpinner viewModel=viewModel.vmLevelEditMode }}
    </div>
    <span class="border-b-sm">
      {{> button viewModel=viewModel.vmRollEditMode }}
    </span>
  </div>
  <div class="read-mode flex flex-row flex-middle">
    <div class="flex flex-center margin-r-md" style="position: relative; width: 3rem; height: 3rem">
      {{{themedImage "image.diamondBg" "fill" "position: relative;"}}}
      <span id="{{viewModel.vmLevelReadMode.id}}" style="position: absolute; font-size: 2rem;">{{viewModel.value}}</span>
    </div>
    <span class="border-b-sm">
      {{> button viewModel=viewModel.vmRollReadMode }}
    </span>
  </div>
</div>