{{!--
viewModel: ButtonDropDownViewModel
--}}
<div id="{{viewModel.id}}" class="strive dropdown">
  <a class="button auto-margin-h-sm{{#if cssClass}} {{cssClass}}{{/if}}" tabindex="0">
    {{#if viewModel.content}}{{{viewModel.content}}}{{/if}}
    {{#if @partial-block}}{{> @partial-block }}{{/if}}
  </a>
  <menu id="{{viewModel.id}}-menu" class="hidden">
  {{#each viewModel.options as |option|}}
    <li data-value="{{option.value}}" role="button" tabindex="-1" class="flex flex-row flex-middle auto-margin-h-lg strive-regular-font">
      {{{option.iconHtml}}}
      <span>{{option.localizedValue}}</span>
    </li>
  {{/each}}
  </menu>
</div>