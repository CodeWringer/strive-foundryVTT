{{!-- Required context:
viewModel: ButtonViewModel
cssClass: String | undefined
--}}
<a class="strive button auto-margin-h-sm{{#if (not viewModel.isEditable)}} disabled{{/if}}{{#if cssClass}} {{cssClass}}{{/if}}" 
  id="{{viewModel.id}}"
  tabindex="0"
>
  {{#if viewModel.content}}{{{viewModel.content}}}{{/if}}
  {{#if @partial-block}}{{> @partial-block }}{{/if}}
</a>