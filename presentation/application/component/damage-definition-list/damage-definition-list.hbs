{{!-- Required context:
viewModel: {DamageDefinitionListViewModel}
cssClass: {String | undefined}
--}}
<div id="{{viewModel.id}}"{{#if cssClass}} class="{{cssClass}}"{{/if}}>
  <h3 class="strive flex flex-row flex-middle{{#if viewModel.showFancyFont}} fancy-font{{/if}}" style="margin: 0;">
    <span class="flex-grow pad-l-sm font-size-lg font-bold{{#if viewModel.showFancyFont}} fancy-font{{/if}}">{{localize "system.damageDefinition.label"}}</span>
    {{!-- Button Add Item --}}
    {{#if viewModel.isEditable}}
    {{> buttonAdd viewModel=viewModel.vmAddItem cssClass="" }}
    {{/if}}
  </h3>
  <div class="flex flex-row flex-middle">
    {{> diceRollList viewModel=viewModel.vmList cssClass="flex-grow" }}
    <span class="button light square font-size-default flex flex-center" id="{{viewModel.vmDamageFormulaInfo.id}}">
      <i class="far fa-question-circle info-button"></i>
    </span>
  </div>
</div>