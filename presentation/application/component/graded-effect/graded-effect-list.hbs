{{!-- 
viewModel: GradedEffectListViewModel
--}}
<div id="{{viewModel.id}}" class="strive graded-effect-list">
  <div class="edit-mode auto-margin-v-md border-t-sm flex flex-column pad-t-md">
    <h3 class="flex flex-row flex-middle strive-regular-font">
      <span class="flex-grow">{{localize "system.domain.gradedEffect.gradedEffects"}}</span>
      {{> buttonDropDown viewModel=viewModel.vmContextMenuButton cssClass="pad-md" }}
    </h3>
    {{{themedImage "image.underline.h2Secondary" "" "min-width: 500px; max-width: 500px;"}}}
  </div>
  <ul>
  {{#each viewModel.entryViewModels as |geVm|}}
  {{#with geVm.clazz.TEMPLATE as | template |}}
  {{> (template) viewModel=geVm }}
  {{/with}}
  {{/each}}
  </ul>
</div>