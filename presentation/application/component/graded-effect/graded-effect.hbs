{{!-- Context:
viewModel: GradedEffectViewModel
--}}
<div id="{{viewModel.id}}" class="strive graded-effect flex flex-row auto-margin-h-md">
  <div class="dynamic flex flex-row flex-middle">
    <div class="emboldable flex flex-row flex-middle auto-margin-h-sm margin-r-sm">
      {{> inputDropDown viewModel=viewModel.vmComparisonType cssClass="" }}
      {{> inputNumberSpinner viewModel=viewModel.vmThreshold cssClass="max-width-md" }}
      {{> inputDropDown viewModel=viewModel.vmComparisonTargetType cssClass="" }}
      {{> inputTextField viewModel=viewModel.vmComparisonTargetData cssClass="" }}
    </div>
    {{> inputRichText viewModel=viewModel.vmUnstructured cssClass="" }}
  </div>
  {{!-- Context menu --}}
  <div class="context-menu flex flex-middle flex-row">
    <span class="v-divider"></span>
    {{> buttonDropDown viewModel=viewModel.vmContextMenu cssClass="" }}
  </div>
</div>