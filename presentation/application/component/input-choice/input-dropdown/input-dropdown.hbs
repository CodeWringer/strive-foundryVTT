{{!-- Required context:
viewModel: InputDropDownViewModel
--}}
{{#if viewModel.isEditable}}
  {{!-- Edit mode --}}
  <select 
    class="strive dropdown strive-regular-font"
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
    value="{{viewModel.value.value}}"
  >
    {{#each viewModel.options as |option index|}}
      <option class="flex flex-middle" value="{{option.value}}" title="{{option.localizedValue}}">
        {{#if option.hasIcon}}
          {{#if option.hasIconClass}}
            <i class="ico {{option.icon}}"></i>
          {{/if}}
        {{/if}}
        <span>{{option.localizedValue}}</span>
      </option>
    {{/each}}
  </select>
{{else}}
  {{!-- Read-only --}}
  <div 
    class="strive dropdown strive-regular-font readonly" 
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
  >{{viewModel.localizedValue}}</div>
{{/if}}
