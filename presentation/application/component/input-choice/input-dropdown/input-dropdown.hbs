{{!-- Required context:
viewModel: InputDropDownViewModel
--}}
{{#if viewModel.isEditable}}
  {{!-- Edit mode --}}
  <div class="strive dropdown" id="{{viewModel.id}}">
    <button id="{{viewModel.id}}-button" aria-controls="{{viewModel.id}}-menu" aria-expanded=false class="flex flex-row flex-middle strive-regular-font">
      {{{viewModel.value.iconHtml}}}
      {{#if viewModel.displayValue}}
      <span>{{viewModel.value.localizedValue}}</span>
      {{/if}}
      <i class="ico ico-triangle-down"></i>
    </button>
    <select 
      id="{{viewModel.id}}-select"
      name="{{viewModel.id}}"
      value="{{viewModel.value.value}}"
      class="hidden"
    >
      {{#each viewModel.options as |option index|}}
        <option value="{{option.value}}">{{option.localizedValue}}</option>
      {{/each}}
    </select>
    <menu id="{{viewModel.id}}-menu">
    {{#each viewModel.options as |option index|}}
      <li id="{{option.value}}" role="button" class="flex flex-row flex-middle strive-regular-font">
        {{{option.iconHtml}}}
        <span>{{option.localizedValue}}</span>
      </li>
    {{/each}}
    </menu>
  </div>
{{else}}
  {{!-- Read-only --}}
  <div 
    class="strive dropdown strive-regular-font readonly" 
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
  >{{viewModel.localizedValue}}</div>
{{/if}}
