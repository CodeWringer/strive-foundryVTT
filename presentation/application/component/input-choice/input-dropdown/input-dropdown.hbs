{{!-- Required context:
viewModel: InputDropDownViewModel
cssClass: String | undefined
--}}
<div id="{{viewModel.id}}" class="strive input dropdown flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode">
    {{#> buttonDropDown viewModel=viewModel.vmDropDown}}
      <div class="edit-value flex flex-row">
        {{{viewModel.value.iconHtml}}}
        {{#if viewModel.showValue}}
        <span>{{viewModel.value.localizedValue}}</span>
        {{/if}}
      </div>
      <span class="flex-grow"></span>
      <div class="flex-center">
        <i class="ico ico-triangle-down xs margin-l-md"></i>
      </div>
    {{/buttonDropDown}}
  </div>
  {{!-- Read mode --}}
  <div 
    class="read-mode flex flex-row" 
    name="{{viewModel.id}}"
  >
    {{{viewModel.value.iconHtml}}}
    {{#if viewModel.showValue}}
    <span>{{viewModel.value.localizedValue}}</span>
    {{/if}}
  </div>
</div>
