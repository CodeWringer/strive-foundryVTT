{{!-- Required context:
viewModel: InputDropDownViewModel
cssClass: String | undefined
--}}
<div id="{{viewModel.id}}" class="strive dropdown flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode{{#if viewModel.isEditable}}{{else}} hidden{{/if}}" >
    <button 
      id="{{viewModel.id}}-button" 
      aria-controls="{{viewModel.id}}-menu" 
      aria-expanded=false 
      class="flex flex-row flex-middle strive-regular-font"
      tabindex="0"
    >
      <div id="{{viewModel.id}}-button-value">
        {{{viewModel.value.iconHtml}}}
        {{#if viewModel.showValue}}
        <span>{{viewModel.value.localizedValue}}</span>
        {{/if}}
      </div>
      <i class="ico ico-triangle-down"></i>
    </button>
    <menu id="{{viewModel.id}}-menu" class="strive dropdown hidden">
    {{#each viewModel.options as |option index|}}
      <li id="{{option.value}}" role="button" tabindex="-1" class="flex flex-row flex-middle auto-margin-h-lg strive-regular-font">
        {{{option.iconHtml}}}
        <span>{{option.localizedValue}}</span>
      </li>
    {{/each}}
    </menu>
  </div>
  {{!-- Read mode --}}
  <div 
    class="read-mode flex{{#if viewModel.isEditable}} hidden{{/if}}" 
    name="{{viewModel.id}}"
  >
    {{{viewModel.value.iconHtml}}}
    {{#if viewModel.showValue}}
    <span>{{viewModel.value.localizedValue}}</span>
    {{/if}}
  </div>
</div>
