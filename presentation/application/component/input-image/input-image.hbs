{{!-- Required context:
viewModel: {InputImageViewModel}
cssClass: {String | undefined}
--}}
<div id="{{viewModel.id}}" class="strive image flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode flex flex-column flex-center flex-grow">
    <img src="{{viewModel.value}}"/>
  </div>
  {{!-- Read mode --}}
  <div class="read-mode flex flex-column flex-center flex-grow">
    <img src="{{viewModel.value}}"/>
  </div>
</div>