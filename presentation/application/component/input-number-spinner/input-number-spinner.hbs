{{!-- Required context:
viewModel: {InputNumberSpinnerViewModel}
cssClass: {String | undefined}
--}}
<div id="{{viewModel.id}}" class="strive number-spinner flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode flex flex-row flex-middle">
    <input 
      type="number"
      data-dtype="Number"
      name="{{viewModel.id}}"
      id="{{viewModel.id}}"
      value="{{viewModel.value}}"
      {{#if viewModel.hasMin}}min="{{viewModel.min}}"{{/if}}
      {{#if viewModel.hasMax}}max="{{viewModel.max}}"{{/if}}
      step="{{viewModel.step}}"
    />
    <div class="flex flex-column flex-center">
      <a class="button-spinner up">
        <i class="ico ico-triangle-up sm margin-l-md"></i>
      </a>
      <a class="button-spinner down">
        <i class="ico ico-triangle-down sm margin-l-md"></i>
      </a>
    </div>
  </div>
  {{!-- Read mode --}}
  <div class="read-mode">{{viewModel.value}}</div>
</div>