{{!-- Required context:
viewModel: {InputNumberSpinnerViewModel}
cssClass: {String | undefined}
--}}
<div id="{{viewModel.id}}" class="strive input number-spinner flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode flex flex-row flex-grow flex-middle">
    <input 
      type="text"
      name="{{viewModel.id}}"
      value="{{viewModel.value}}"
    />
    <div class="flex flex-column flex-center">
      <a class="button-spinner up">
        <i class="ico ico-triangle-up sm margin-l-md"></i>
      </a>
      <a class="button-spinner down">
        <i class="ico ico-triangle-down sm margin-l-md"></i>
      </a>
    </div>
  </div>
  {{!-- Read mode --}}
  <div class="read-mode flex flex-center flex-grow">{{viewModel.value}}</div>
</div>