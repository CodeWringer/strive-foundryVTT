{{!-- Required context:
viewModel: InputRichTextViewModel
--}}
{{!-- Edit mode --}}
<prose-mirror 
  class="edit-mode editor prosemirror active"
  name="viewModel.value"
  relative
  editable="true"
  value="{{viewModel.value}}"
>{{{viewModel.enrichedHtml}}}</prose-mirror>
{{!-- Read mode --}}
<div class="read-mode">{{{viewModel.enrichedHtml}}}</div>