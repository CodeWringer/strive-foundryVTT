{{!-- Required context:
viewModel: InputRichTextViewModel
cssClass: String | undefined
--}}
<div
  class="strive rich-text fill{{#if cssClass}} {{cssClass}}{{/if}}" 
  id="{{viewModel.id}}" 
>
  <div class="strive rich-text editbutton{{#if viewModel.isEditable}}{{else}} hidden{{/if}}">
    {{> button viewModel=viewModel.vmBtnEditMode fill=true }}
  </div>
  <div class="strive rich-text content hidden"></div>
  <div id="content" class="rich-text-read-only"></div>
</div>