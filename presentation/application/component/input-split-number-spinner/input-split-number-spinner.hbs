{{!-- Required context:
viewModel: InputSplitNumberSpinnerViewModel
cssClass: String | undefined
--}}
<div id="{{viewModel.id}}" class="strive input split-number-spinner flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode flex flex-column">
    {{> inputNumberSpinner viewModel=viewModel.vmCurrent }}
    <span class="h-divider-full"></span>
    {{> inputNumberSpinner viewModel=viewModel.vmMaximum }}
  </div>
  {{!-- Read mode --}}
  <div class="read-mode flex flex-column">
    {{viewModel.vmCurrent.value}}
    <span class="h-divider-full"></span>
    {{viewModel.vmMaximum.value}}
  </div>
</div>
