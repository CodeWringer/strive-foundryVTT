{{!-- Required context:
viewModel: InputTextFieldViewModel
cssClass: String | undefined
readOnlyCssClass: String | undefined
--}}
{{#if viewModel.isEditable}}
  <input 
    class="custom-system-edit input-width-override textfield {{cssClass}}"
    type="text"
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
    placeholder="{{viewModel.placeholder}}"
    value="{{viewModel.value}}"
  />
{{else}}
  {{!-- Display read-only value --}}
  <div 
    class="custom-system-read-only pad-sm border-solid-sm fill textfield {{readOnlyCssClass}}" 
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
  >
    {{viewModel.localizedValue}}
  </div>
{{/if}}
