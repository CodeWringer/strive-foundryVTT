{{!-- Required context:
viewModel: InputTextFieldViewModel
cssClass: String | undefined
--}}
<div id="{{viewModel.id}}" class="strive input textfield flex flex-middle strive-regular-font{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Edit mode --}}
  <div class="edit-mode flex flex-row flex-middle auto-margin-h-md">
    {{#if viewModel.icon}}{{{viewModel.icon}}}{{/if}}
    <input 
      type="text"
      name="{{viewModel.id}}"
      value="{{viewModel.value}}"
      placeholder="{{viewModel.placeholder}}"
    />
    {{> button viewModel=viewModel.vmClear cssClass="pad-md" }}
  </div>
  {{!-- Read mode --}}
  <div class="read-mode">
    <span>{{viewModel.value}}</span>
  </div>
</div>