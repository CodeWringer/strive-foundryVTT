{{!-- Required context:
viewModel: InputTextFieldViewModel
--}}
{{#if viewModel.isEditable}}
  {{!-- Edit mode --}}
  <input 
    class="strive textfield strive-regular-font"
    type="text"
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
    placeholder="{{viewModel.placeholder}}"
    value="{{viewModel.value}}"
  />
{{else}}
  {{!-- Read-only --}}
  <div 
    class="strive textfield strive-regular-font readonly" 
    name="{{viewModel.id}}"
    id="{{viewModel.id}}"
  >{{viewModel.localizedValue}}</div>
{{/if}}
