{{!--
viewModel: ListItemViewModel
--}}
<li id="{{viewModel.id}}">
  <div class="flex flex-row flex-middle border-b-sm">
    {{!-- Header --}}
    {{#if viewModel.hasHeaderViewModel}}
    {{#with viewModel.item.header.template as | template |}}
      {{> (template) viewModel=../viewModel.vmHeader }}
    {{/with}}
    {{else}}
      {{{viewModel.item.header.html}}}
    {{/if}}
    {{!-- Context menu --}}
    <span class="v-divider context-menu"></span>
    {{> buttonDropDown viewModel=viewModel.vmContextMenu cssClass="context-menu" }}
  </div>
  {{!-- Content --}}
  <div class="margin-l-xl margin-b-xl margin-r-xl border-l-sm border-b-sm border-r-sm secondary">
    {{#if viewModel.hasContent}}
    {{#with viewModel.item.content.template as | template |}}
      {{> (template) viewModel=../viewModel.vmContent }}
    {{/with}}
    {{else}}
      {{{viewModel.item.content.html}}}
    {{/if}}
  </div>
</li>