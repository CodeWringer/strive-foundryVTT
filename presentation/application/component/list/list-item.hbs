{{!--
viewModel: ListItemViewModel
--}}
<li id="{{viewModel.id}}" class="flex flex-row flex-grow">
  {{#if viewModel.hasContentViewModel}}
    {{#with viewModel.contentViewModel.clazz.TEMPLATE as |template|}}
      {{> (template) viewModel=../viewModel.contentViewModel }}
    {{/with}}
  {{/if}}
  {{#if viewModel.hasHtml}}
    {{{viewModel.html}}}
  {{/if}}
  {{!-- Context menu --}}
  {{#if viewModel.showContextMenu }}
    <span class="v-divider"></span>
    {{> buttonDropDown viewModel=viewModel.vmContextMenu cssClass="" }}
  {{/if}}
</li>
