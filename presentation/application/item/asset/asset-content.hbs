{{!-- context:
viewModel: AssetContentViewModel
--}}
{{> inputRichText viewModel=viewModel.vmDescription cssClass="pad-md" }}
<div class="auto-margin-v-md pad-h-md">
  <span class="h-divider"></span>
  <div class="flex flex-row flex-middle auto-margin-h-md">
    <div class="flex flex-row flex-middle">
      <i class="ico ico-bulk xl"></i>
      {{> inputNumberSpinner viewModel=viewModel.vmBulk cssClass="width-lg" }}
    </div>
    <span class="v-divider"></span>
    <div class="flex flex-row flex-middle">
      <i class="ico ico-quality xl"></i>
      {{> inputNumberSpinner viewModel=viewModel.vmQuality cssClass="width-lg" }}
    </div>
  </div>
  <span class="h-divider"></span>
  {{#with viewModel.vmComplications.clazz.TEMPLATE as |template|}}
  {{> (template) viewModel=../viewModel.vmComplications }}
  {{/with}}
</div>