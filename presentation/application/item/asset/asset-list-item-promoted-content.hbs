{{!-- Parameters:
viewModel: {IllnessListItemViewModel}
--}}
<div id="{{viewModel.id}}" class="flex flex-row flex-wrap auto-margin-h-md">
  {{!-- Quantity / Maximum Quantity --}}
  {{#with viewModel.quantityAndMaxTemplate as |template|}}
    {{> (template) viewModel=../viewModel.vmCompositeQuantity cssClass="sheet-block" }}
  {{/with}}
  {{!-- Quality --}}
  <div id="{{viewModel.vmQualityWrap.id}}" class="flex flex-row flex-middle auto-margin-h-sm sheet-block">
    <i id="{{viewModel.vmQualityIcon.id}}" class="ico dark ico-quality-solid"></i>
    {{> inputNumberSpinner viewModel=viewModel.vmQuality cssClass="width-md" }}
  </div>
  {{!-- Bulk --}}
  <div id="{{viewModel.vmBulkWrap.id}}" class="flex flex-row flex-middle auto-margin-h-sm sheet-block">
    <i id="{{viewModel.vmBulkIcon.id}}" class="ico dark ico-bulk-solid"></i>
    {{> inputNumberSpinner viewModel=viewModel.vmBulk cssClass="width-md" }}
  </div>
</div>
{{#if viewModel.isProperty}}
{{!-- Location --}}
<div id="{{viewModel.vmLocationWrap.id}}" class="flex flex-row flex-grow flex-middle auto-margin-h sheet-block">
  <i class="ico dark ico-location-solid"></i>
  {{> inputTextField viewModel=viewModel.vmLocation }}
</div>
{{/if}}
