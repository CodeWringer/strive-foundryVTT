{{!-- context:
viewModel: BaseItemContentViewModel
--}}
<div id="{{viewModel.id}}" class="flex flex-column content">
  {{!-- Inheritor content --}}
  {{#with viewModel.clazz.TEMPLATE as | template |}}
  {{> (template) viewModel=../viewModel }}
  {{/with}}
  {{!-- GM section --}}
  {{#if viewModel.isGM}}
  <div class="gm-only flex-grow">
    <h2 class="strive flex flex-column strive-regular-font" style="font-weight: normal;">
      <a id="{{viewModel.id}}-gm-header" class="pad-l-md pad-t-md">{{localize "system.general.gm.gm"}}</a>
      {{{themedImage "image.underline.h2" "" "min-width: 500px; max-width: 500px;"}}}
    </h2>
    <div class="gm-notes hidden">
      {{> inputRichText viewModel=viewModel.vmGmNotes cssClass="pad-md" }}
    </div>
    <div class="flex flex-center gm-notes-hidden-indicator">
      <i class="ico ico-eye-slash xl"></i>
    </div>
  </div>
  {{/if}}
</div>