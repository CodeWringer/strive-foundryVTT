{{!-- context:
viewModel: BaseItemHeaderViewModel
--}}
<div id="{{viewModel.id}}" class="flex flex-row flex-grow pad-lg auto-margin-h-md header">
  {{> inputImage viewModel=viewModel.vmImg cssClass="lg" }}
  <span class="v-divider"></span>
  {{> inputTextField viewModel=viewModel.vmName cssClass="flex-grow lg" }}
  {{!-- Inheritor content --}}
  {{#with viewModel.clazz.TEMPLATE as | template |}}
  {{> (template) viewModel=../viewModel }}
  {{/with}}
</div>