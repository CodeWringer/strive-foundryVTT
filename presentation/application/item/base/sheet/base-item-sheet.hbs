{{!-- context:
viewModel: BaseItemSheetViewModel
--}}
<section id="{{viewModel.id}}" class="strive flex flex-column flex-grow sheet-section">
  <div class="border-b-md">
    {{#with viewModel.headerTemplate as | template |}}
    {{> (template) viewModel=../viewModel.headerViewModel }}
    {{/with}}
  </div>
  {{#with viewModel.contentTemplate as | template |}}
  {{> (template) viewModel=../viewModel.contentViewModel }}
  {{/with}}
</section>