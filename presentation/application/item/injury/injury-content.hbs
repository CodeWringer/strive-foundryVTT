{{!-- context:
viewModel: InjuryContentViewModel
--}}
<div class="pad-h-md">
  {{!-- Description --}}
  {{> inputRichText viewModel=viewModel.vmDescription cssClass="" }}
  <span class="h-divider"></span>
  <div class="auto-margin-v-md flex flex-middle flex-row">
    {{!-- Treatment Obstacle --}}
    <div class="treatment-obstacle flex flex-row flex-middle">
      <i class="ico ico-obstacle xl"></i>
      {{> inputTextField viewModel=viewModel.vmTreatmentObstacle cssClass="" }}
      <span class="v-divider"></span>
    </div>
    {{!-- Treatment Skill --}}
    <div class="treatment-skill flex flex-row flex-middle">
      <i class="ico ico-arrow-right lg"></i>
      {{> inputReference viewModel=viewModel.vmTreatmentSkill cssClass="flex-grow" }}
      <span class="v-divider"></span>
    </div>
    {{!-- Treatment Supplies --}}
    <div class="treatment-supplies flex flex-row flex-middle">
      <i class="ico ico-treatment-supplies xl"></i>
      {{> inputNumberSpinner viewModel=viewModel.vmTreatmentSuppliesAmount cssClass="" }}
      {{> inputReference viewModel=viewModel.vmTreatmentSuppliesAsset cssClass="flex-grow" }}
      <span class="v-divider"></span>
    </div>
  </div>
</div>