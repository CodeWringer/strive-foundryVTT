{{!-- context:
viewModel: LanguageItemSheetViewModel
--}}
<div class="flex flex-row pad-lg border-b-md">
  {{> inputTextField viewModel=viewModel.vmName cssClass="flex-grow" }}
  <span class="v-divider"></span>
  {{> inputDropDown viewModel=viewModel.vmGrade }}
  <span class="v-divider"></span>
  {{> inputDropDown viewModel=viewModel.vmReadAndWrite }}
</div>
<div class="flex flex-column">
  {{> inputRichText viewModel=viewModel.vmDescription }}
  {{#if viewModel.isGM}}
  {{> inputRichText viewModel=viewModel.vmGmNotes }}
  {{/if}}
</div>