{{!-- context:
viewModel: LanguageItemSheetViewModel
--}}
<div id="{{viewModel.id}}" class="flex flex-row pad-lg border-b-md auto-margin-h-md">
  {{> inputImage viewModel=viewModel.vmImg cssClass="lg" }}
  <span class="v-divider"></span>
  {{> inputTextField viewModel=viewModel.vmName cssClass="flex-grow lg" }}
  <span class="v-divider"></span>
  {{> inputDropDown viewModel=viewModel.vmGrade cssClass="lg" }}
  <span class="v-divider"></span>
  {{> inputDropDown viewModel=viewModel.vmReadAndWrite cssClass="lg" }}
</div>