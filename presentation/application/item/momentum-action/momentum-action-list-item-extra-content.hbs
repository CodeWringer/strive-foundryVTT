{{!--
viewModel: MomentumActionItemSheetViewModel
--}}
<section class="grid-2col grid-gap-sm margin-t-lg">
  {{!-- Heroics --}}
  <div class="sheet-block">
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex flex-end flex-row auto-margin-h-md"}}
      {{> inputImage viewModel=viewModel.vmImgHeroic cssClass="custom-icon-md" }}
      {{> inputTextField viewModel=viewModel.vmNameHeroic cssClass="minimal-input"}}
    {{/header2}}
    <div class="flex flex-column">
      {{> inputRichText viewModel=viewModel.vmDescriptionHeroic }}
    </div>
  </div>
  {{!-- Desperation --}}
  <div class="sheet-block">
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex flex-end flex-row auto-margin-h-md"}}
      {{> inputImage viewModel=viewModel.vmImgDesperate cssClass="custom-icon-md" }}
      {{> inputTextField viewModel=viewModel.vmNameDesperate cssClass="minimal-input"}}
    {{/header2}}
    <div class="flex flex-column">
      {{> inputRichText viewModel=viewModel.vmDescriptionDesperate }}
    </div>
  </div>
</section>