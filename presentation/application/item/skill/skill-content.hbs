{{!-- context:
viewModel: SkillContentViewModel
--}}
{{> inputRichText viewModel=viewModel.vmDescription cssClass="pad-md" }}
<div class="auto-margin-v-md pad-h-md">
  <span class="h-divider"></span>
  <div class="grid col6 gap-md border-between-rows border-between-cols margin-b-md">
    {{!-- Action Points --}}
    <div id="{{viewModel.id}}-ap" class="flex flex-row flex-middle auto-margin-h-md">
      <div class="flex flex-row flex-middle">
        <i class="ico ico-action-point xl"></i>
        {{> inputNumberSpinner viewModel=viewModel.vmActionPoints cssClass="width-md" }}
      </div>
    </div>
    {{!-- Distance --}}
    <div id="{{viewModel.id}}-distance" class="flex flex-row flex-middle auto-margin-h-md">
      <div class="flex flex-row flex-middle">
        <i class="ico ico-distance xl"></i>
        {{> inputNumberSpinner viewModel=viewModel.vmDistance cssClass="width-md" }}
      </div>
    </div>
    {{!-- Targeting Type --}}
    <div id="{{viewModel.id}}-targeting-type" class="flex flex-row flex-middle auto-margin-h-md">
      {{> inputDropDown viewModel=viewModel.vmTargetingType cssClass="" }}
    </div>
    {{!-- Advancement --}}
    <div id="{{viewModel.id}}-advancement" class="flex flex-row flex-middle auto-margin-h-md">
      <div class="flex flex-row flex-middle">
        <i class="ico ico-dumbbell xl"></i>
        {{> inputSplitNumberSpinner viewModel=viewModel.vmAdvancement cssClass="width-md" }}
      </div>
    </div>
    {{!-- Obstacle --}}
    <div id="{{viewModel.id}}-ob" class="flex flex-row flex-middle auto-margin-h-md grid-span-6">
      <div class="flex flex-row flex-middle">
        <i class="ico ico-obstacle xl"></i>
        {{> inputTextField viewModel=viewModel.vmObstacle cssClass="" }}
      </div>
      <div class="flex flex-row flex-middle flex-grow">
        <i class="ico ico-arrow-right lg"></i>
        {{> inputReference viewModel=viewModel.vmOpposedSkill cssClass="flex-grow" }}
      </div>
    </div>
  </div>
</div>
{{!-- Graded Effects --}}
<span class="h-divider"></span>
{{#with viewModel.vmGradedEffects.clazz.TEMPLATE as | template |}}
{{> (template) viewModel=../viewModel.vmGradedEffects }}
{{/with}}
{{!-- Expertises --}}
{{#with viewModel.vmExpertises.clazz.TEMPLATE as | template |}}
{{> (template) viewModel=../viewModel.vmExpertises }}
{{/with}}
