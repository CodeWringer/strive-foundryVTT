{{!-- context:
viewModel: SkillHeaderViewModel
--}}
<div class="embedded-only flex flex-row flex-middle auto-margin-h-md">
  <span class="v-divider"></span>
  {{> abilityLevel viewModel=viewModel.vmLevel cssClass="lg" }}
</div>
<div class="ap-cost flex flex-row flex-middle auto-margin-h-md">
  <span class="v-divider hover-only"></span>
  <div class="flex flex-column flex-wrap hover-only">
    {{#times viewModel.apCost }}
    <i class="ico ico-action-point-solid dark"></i>
    {{/times}}
  </div>
</div>
<span class="v-divider"></span>
<div id="{{viewModel.vmBaseAttributes.id}}" class="flex flex-column flex-center auto-margin-v-md">
  {{#each viewModel.baseAttributeVms as |vm|}}
  {{> inputDropDown viewModel=vm cssClass="attribute" }}
  {{/each}}
</div>