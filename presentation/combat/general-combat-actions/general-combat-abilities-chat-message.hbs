{{!-- Parameters:
viewModel: {GeneralCombatAbilitiesViewModel}
cssClass: {undefined | String}
--}}
<section 
  id="{{viewModel.id}}" 
  class="custom-system-chat-message"
  data-view-model-id="{{viewModel.id}}"
  data-view-model-class="GeneralCombatAbilitiesViewModel",
>
  {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex flex-column flex-grow"}}
    <span>{{localize "system.character.abilities.general.header"}}</span>
    <span class="font-size-sm">{{localize "system.general.reminder.ruleReminders"}}</span>
  {{/header2}}
  <div id="{{viewModel.id}}-content" class="grid-2col grid-gap-md">
    {{#each viewModel.reminders as |reminder|}}
    <span id="{{reminder.viewModel.id}}" class="flex flex-row flex-middle auto-margin-h-md">
      <span class="flex-grow font-size-default{{#if viewModel.showFancyFont}} fancy-font{{/if}}">{{localize reminder.localizableLabel}}</span>
      <i class="far fa-question-circle font-size-lg"></i>
    </span>
    {{/each}}
  </div>
</section>