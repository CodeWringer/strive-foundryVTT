{{!--
viewModel: SimpleListViewModel
--}}
{{!-- The item's content --}}
<li id="{{viewModel.id}}" class="flex flex-row flex-grow">
  {{#with viewModel.itemTemplate as |template|}}
    <div class="flex flex-grow">
      {{> (template) viewModel=../viewModel.itemViewModel}}
    </div>
  {{/with}}
  {{!-- Remove button --}}
  {{#if viewModel.isRemovable}}
  {{> button viewModel=viewModel.vmBtnRemove }}
  {{/if}}
</li>
