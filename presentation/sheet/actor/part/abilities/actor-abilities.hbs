{{!-- Parameters:
viewModel: {ActorAbilitiesViewModel}
cssClass: {undefined | String}
--}}
<section id="{{viewModel.id}}" class="auto-margin-v-lg{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- Attributes --}}
  {{#with viewModel.attributesTemplate as | template |}}
    {{> (template) viewModel=../viewModel.vmAttributes }}
  {{/with}}
  {{!-- Divider --}}
  {{> hDivider}}
  <div class="flex flex-row flex-center auto-margin-h-lg">
    {{!-- Base Initiative --}}
    <div class="flex flex-column flex-middle sheet-block" style="width: 90px; height: 90px;">
      {{!-- Icon --}}
      <div class="flex flex-row flex-middle">
        <i id="{{viewModel.vmBaseInitiativeIcon.id}}" class="ico dark ico-base-initiative-solid" style="width: 48px; height: 48px;"></i>
      </div>
      <div class="flex flex-row flex-middle">
        {{> readOnlyValue viewModel=viewModel.vmBaseInitiative cssClass="width-md" }}
      </div>
    </div>
    {{!-- Sprinting Speed --}}
    <div class="flex flex-column flex-middle sheet-block" style="width: 90px; height: 90px;">
      {{!-- Icon --}}
      <div class="flex flex-row flex-middle">
        <i id="{{viewModel.vmSprintingSpeedIcon.id}}" class="ico dark ico-sprinting-speed-solid" style="width: 32px; height: 32px; margin: 8px;"></i>
        {{> buttonRoll viewModel=viewModel.vmRollSprintingSpeed }}
      </div>
      <div class="flex flex-row flex-middle">
        {{> readOnlyValue viewModel=viewModel.vmSprintingSpeed cssClass="width-md" }}
      </div>
    </div>
    {{!-- Stability --}}
    <div class="flex flex-column flex-middle sheet-block" style="width: 90px; height: 90px;">
      {{!-- Icon --}}
      <div class="flex flex-row flex-center" style="min-height: 48px;">
        <i id="{{viewModel.vmStabilityIcon.id}}" class="ico dark ico-stability-solid" style="width: 32px; height: 32px; margin: 8px;"></i>
      </div>
      <div class="flex flex-row flex-middle">
        {{> readOnlyValue viewModel=viewModel.vmStability cssClass="width-md" }}
      </div>
    </div>
    {{#if viewModel.advancementEnabled}}
    {{!-- Experience Points --}}
    <div class="flex flex-column flex-middle sheet-block" style="width: 90px; height: 90px;">
      {{!-- Symbol --}}
      <div class="flex flex-row flex-center" style="min-height: 48px;">
        <i id="{{viewModel.vmExperiencePointsSymbol.id}}" class="ico dark ico-experience-points-solid" style="width: 32px; height: 32px; margin: 8px;"></i>
      </div>
      <div class="flex flex-row flex-middle">
        {{> inputNumberSpinner viewModel=viewModel.vmExperiencePoints cssClass="width-md" }}
      </div>
    </div>
    {{/if}}
  </div>
  {{!-- Traits --}}
  {{#if viewModel.showTraits}}
  {{#with viewModel.traitsTemplate as | template |}}
    {{> (template) viewModel=../viewModel.vmTraits }}
  {{/with}}
  {{/if}}
  {{!-- Momentum Actions --}}
  {{#if viewModel.showMomentum}}
  {{#with viewModel.momentumActionsTemplate as | template |}}
    {{> (template) viewModel=../viewModel.vmMomentumActions }}
  {{/with}}
  {{/if}}
  {{!-- Skills --}}
  {{#with viewModel.skillsTemplate as | template |}}
    {{> (template) viewModel=../viewModel.vmSkills }}
  {{/with}}
</section>