{{!-- Parameters:
viewModel: {ActorHealthViewModel}
cssClass: {undefined | String}
--}}
<section id="{{viewModel.id}}" class="auto-margin-v-xl{{#if cssClass}} {{cssClass}}{{/if}}">
  {{!-- General health stats --}}
  {{#with viewModel.generalHealthStatsTemplate as |context|}}
  {{#with context.template as |template|}}
  {{> (template) viewModel=context.viewModel cssClass=context.cssClass }}
  {{/with}}
  {{/with}}
  {{!-- Injuries --}}
  {{> compositeSortableList viewModel=viewModel.vmInjuries }}
  {{!-- Illnesses --}}
  {{> compositeSortableList viewModel=viewModel.vmIllnesses }}
  {{!-- Mutations --}}
  {{> compositeSortableList viewModel=viewModel.vmMutations }}
  {{!-- Scars --}}
  {{> compositeSortableList viewModel=viewModel.vmScars }}
</section>