{{!-- Parameters:
viewModel: {HealthConditionChatMessageViewModel}
cssClass: {undefined | String}
--}}
<section class="custom-system-chat-message{{#if cssClass}} {{cssClass}}{{/if}}" 
  id="{{viewModel.id}}"
  data-view-model-id="{{viewModel.id}}"
  data-document-id="{{viewModel.entityId}}"
>
  {{!-- Header --}}
  <div class="flex flex-row">
    <div class="flex flex-center">
      <img class="inline-img custom-icon-chat margin-r-sm" name="img" src="{{viewModel.document.img}}" title="{{viewModel.document.name}}" height="35" width="35" />
    </div>
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex-grow"}}{{viewModel.document.name}}{{/header2}}
  </div>
  {{#if viewModel.showDescription }}
  {{!-- Description --}}
  <div class="sheet-block">
    {{> lazyRichText viewModel=viewModel.vmLazyDescription }}
  </div>
  {{/if}}
  {{!-- Data Fields --}}
  <ul>
    {{#each viewModel.dataFields as |dataField|}}
      {{#with dataField.template as |template|}}
        <li id="{{dataField.wrapViewModel.id}}" class="flex flex-row flex-middle auto-margin-h-sm{{#if dataField.cssClass}} {{dataField.cssClass}}{{/if}}{{#if dataField.isHidden}} hidden{{/if}}">
          {{#if dataField.iconClass}}<i class="ico dark {{dataField.iconClass}}"></i>{{/if}}
          {{#if dataField.localizedLabel}}<span>{{dataField.localizedLabel}}</span>{{/if}}
          {{> (template) viewModel=dataField.viewModel }}
        </li>
      {{/with}}
    {{/each}}
  </ul>
  {{!-- Additional Content --}}
  {{#if viewModel.additionalContent}}
  {{#with viewModel.additionalContent.template as |template|}}
    {{> (template) viewModel=../viewModel.additionalContent.viewModel cssClass=../viewModel.additionalContent.cssClass }}
  {{/with}}
  {{/if}}
</section>