{{!-- Parameters:
viewModel: {ExpertiseListItemViewModel}
--}}
{{!-- Damage --}}
<div id="{{viewModel.id}}" class="flex flex-row border-solid-t-sm{{#if viewModel.hideDamage}} hidden{{/if}}">
  {{> damageDefinitionList viewModel=viewModel.vmDamageDefinitionList cssClass="flex-grow" }}
  <span class="button light square font-size-default flex flex-center" id="{{viewModel.id}}-damage-info">
    <i class="far fa-question-circle info-button"></i>
  </span>
</div>
