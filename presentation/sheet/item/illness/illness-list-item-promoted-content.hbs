{{!-- Parameters:
viewModel: {IllnessListItemViewModel}
--}}
<div id="{{viewModel.id}}" class="flex flex-row flex-wrap auto-margin-h">
  <div class="grid grid-2col grid-gap-sm">
    {{!-- Duration --}}
    <div id="{{viewModel.vmDurationWrap.id}}" class="flex flex-row flex-grow flex-middle auto-margin-h sheet-block">
      <i class="ico dark ico-duration-solid"></i>
      {{> inputTextField viewModel=viewModel.vmDuration }}
    </div>
  </div>
</div>
