{{!-- Parameters:
viewModel: {MomentumActionChatMessageViewModel}
cssClass: {undefined | String}
--}}
<section class="custom-system-chat-message{{#if cssClass}} {{cssClass}}{{/if}}" 
  id="{{viewModel.id}}"
  data-view-model-id="{{viewModel.id}}"
  data-document-id="{{viewModel.entityId}}"
>
  {{!-- Header --}}
  <div class="flex flex-row">
    <div class="flex flex-center">
      <img class="inline-img custom-icon-chat margin-r-sm" name="img" src="{{viewModel.document.img}}" title="{{viewModel.document.name}}" height="35" width="35" />
    </div>
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex-grow"}}{{viewModel.document.name}}{{/header2}}
  </div>
  {{!-- Heroics --}}
  <div class="flex flex-column auto-margin-v-sm sheet-block">
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex flex-row flex-middle auto-margin-h-md"}}
      <img src="{{viewModel.imgHeroic}}" class="custom-icon-md">
      <span>{{viewModel.nameHeroic}}</span>
    {{/header2}}
    <div class="flex flex-row flex-middle">
      {{#if (gt viewModel.momentumShiftHeroic 0)}}
      <i class="ico dark ico-momentum-shift-heroism-solid"></i>
      {{else}}
      <i class="ico dark ico-momentum-shift-desperation-solid"></i>
      {{/if}}
      <span>{{localize "system.combat.momentum.shift"}}: {{viewModel.momentumShiftHeroic}}</span>
    </div>
    <div class="flex flex-column">
      {{> lazyRichText viewModel=viewModel.vmLazyDescriptionHeroic}}
    </div>
  </div>
  {{!-- Desperation --}}
  <div class="flex flex-column auto-margin-v-sm sheet-block">
    {{#> header2 showFancyFont=viewModel.showFancyFont cssClass="flex flex-row flex-middle auto-margin-h-md"}}
      <img src="{{viewModel.imgDesperate}}" class="custom-icon-md">
      <span>{{viewModel.nameDesperate}}</span>
    {{/header2}}
    <div class="flex flex-row flex-middle">
      {{#if (gt viewModel.momentumShiftDesperate 0)}}
      <i class="ico dark ico-momentum-shift-heroism-solid"></i>
      {{else}}
      <i class="ico dark ico-momentum-shift-desperation-solid"></i>
      {{/if}}
      <span>{{localize "system.combat.momentum.shift"}}: {{viewModel.momentumShiftDesperate}}</span>
    </div>
    <div class="flex flex-column">
      {{> lazyRichText viewModel=viewModel.vmLazyDescriptionDesperate}}
    </div>
  </div>
</section>